# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# Firebase (Console do Firebase > Configurações do projeto > Seus apps > Web).
# Esses valores não são segredos, mas ficam em variáveis de ambiente para
# facilitar trocar de projeto Firebase sem mexer no código.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço do backend Flask
VITE_API_URL=http://localhost:5000
