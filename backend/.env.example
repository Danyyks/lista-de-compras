# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env de verdade NUNCA deve ser commitado (ele já está no .gitignore).

# Caminho para o arquivo JSON da chave de conta de serviço do Firebase.
# Você baixa esse arquivo em: Firebase Console > Configurações do projeto >
# Contas de serviço > Gerar nova chave privada.
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Porta em que o Flask vai rodar localmente.
PORT=5000

# Endereço do frontend — único que fica liberado a chamar essa API (CORS).
FRONTEND_URL=http://localhost:5173

# "true" só em desenvolvimento local. Em produção, deixe "false" (ou nem
# defina essa variável) — debug=True expõe um console que executa código
# no servidor quando algo dá erro.
FLASK_DEBUG=true
